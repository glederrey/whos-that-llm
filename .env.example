# Three env files, all untracked. Each holds the same names as below.
#   .env.local              defaults for every mode (`npm run build`, `npm start`)
#   .env.development.local  your DEV Supabase project. `npm run dev` loads it
#                           and it overrides .env.local.
#   .env.prod.local         the PRODUCTION project. `npm run dev:prod` loads it
#                           on top of everything else. Use it with care.
# Never commit any of them.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Openrouter
OPENROUTER_API_KEY=
OPENROUTER_MANAGEMENT_KEY=

# Who's that LLM? API
AVAILABILITY_TOKEN=
